20px;border-radius:20px;font-weight:900;box-shadow:var(--shadow);transform:rotate(-4deg)}.badge small{display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:.12em}.section{padding:86px 0}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.section h2{font-size:clamp(2rem,4vw,3.6rem);letter-spacing:-.06em;line-height:1;margin:10px 0}.section-intro{max-width:490px;color:var(--muted)}.cream-band{background:#f7ead8}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:var(--paper);border:1px solid var(--line);border-radius:24px;overflow:hidden;transition:.25s}.card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.card img{width:100%;height:210px;object-fit:cover;display:block}.card-body{padding:22px}.tag{display:inline-block;color:var(--tomato);font-size:.72rem;font-weight:900;letter-spacing:.1em;text-transform:uppercase;margin-bottom:8px}.card h3{margin:0 0 8px;font-size:1.35rem;letter-spacing:-.04em}.card p{margin:0;color:var(--muted);font-size:.95rem}.recipe{display:grid;grid-template-columns:.9fr 1.1fr;gap:20px}.recipe-photo{min-height:430px;background:url('https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=1200&q=85') center/cover;border-radius:28px}.recipe-box{background:var(--ink);color:#fff;border-radius:28px;padding:38px}.recipe-box h3{font-size:2rem;line-height:1.05;margin:10px 0 25px;letter-spacing:-.05em}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:30px}.fact{background:rgba(255,255,255,.1);border-radius:16px;padding:14px}.fact b{display:block;color:var(--gold);font-size:1.3rem}.checklist{display:grid;gap:13px;padding:0;margin:0;list-style:none}.checklist li:before{content:'✓';color:var(--gold);font-weight:900;margin-right:10px}.steps{display:grid;gap:16px;margin-top:25px}.step{display:grid;grid-template-columns:36px 1fr;gap:13px;align-items:start}.step-no{width:32px;height:32px;border-radiu